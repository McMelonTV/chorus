// Main.chorus
class Main satisfies Program {
    void main() {
        const f32 PI := 3.14;

        Car car := new();
        bool ready := true;

        print(ready ? car.name : "not ready");

        i8? speed := none;
        speed :? print(speed!) : print(0);
    }
}

// Vehicle.chorus
interface Vehicle {
    @get string name;
}

// Car.chorus
class Car satisfies Vehicle {
    @get
    string name;

    embed f32v3 position := #(0);

    new() {
        name := "Car";
    }

    self move(f32v3 offset) {
        position += offset;
        return this;
    }
}